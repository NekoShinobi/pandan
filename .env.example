DATABASE_URL=sqlite://data/pandan.db
PORT=9651
RUST_LOG=info
# Persistent structured application logs. Rotation, retention, enablement, and
# the file level are managed by administrators in Settings → Logs.
PANDAN_LOG_DIR=data/logs
API_URL=http://localhost:9651
UI_PORT=5173
VITE_USE_POLLING=true
COOKIE_SECURE=false
# Public absolute URL of this installation. Derives the OIDC callback and the
# absolute URLs in link-preview tags.
PANDAN_BASE_URL=http://localhost:9651

# Production image process and data-volume ownership.
PUID=99
PGID=100

# Optional OpenID Connect provider. Set all three required values to enable SSO.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Company SSO

# Optional encryption key for stored provider credentials. Generate with: openssl rand -base64 32
PANDAN_SECRET_KEY=

# Where downloaded podcast episodes are stored. Must be on a writable volume with room
# for the storage budget administrators configure in the Podcasts page.
PANDAN_MEDIA_DIR=data/podcasts

# Account-private yt-dlp output. Production Compose stores it in the existing
# /app/data volume. Host development also requires yt-dlp, ffmpeg, and Deno.
PANDAN_DOWNLOAD_DIR=data/downloads
PANDAN_DOWNLOADS_ENABLED=true
# Optional explicit tool paths for host development. Leave blank to use PATH.
PANDAN_YTDLP_BIN=
PANDAN_FFMPEG_BIN=
PANDAN_DENO_BIN=

# Optional public Invidious instance. Pandan falls back to YouTube if it is unavailable.
INVIDIOUS_BASE_URL=

# Set to true only when INVIDIOUS_BASE_URL is a self-hosted instance that resolves to a
# private address. It exempts that one host from the private-network guard; every other
# outbound URL stays fully validated.
INVIDIOUS_ALLOW_PRIVATE_NETWORK=
