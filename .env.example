DATABASE_URL=sqlite://data/pandan.db
PORT=9651
RUST_LOG=info
API_URL=http://localhost:9651
UI_PORT=5173
VITE_USE_POLLING=true
COOKIE_SECURE=false

# Optional OpenID Connect provider. Set all four required values to enable SSO.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_PROVIDER_NAME=Company SSO

# Optional public Invidious instance. Pandan falls back to YouTube if it is unavailable.
INVIDIOUS_BASE_URL=
