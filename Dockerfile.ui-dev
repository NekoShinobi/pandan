# syntax=docker/dockerfile:1.7

# Vite must run under Node; Bun remains the package manager.
FROM node:24-bookworm-slim

ARG DEV_UID=1000
ARG DEV_GID=1000

ENV DEV_UID=${DEV_UID} \
    DEV_GID=${DEV_GID}

COPY --from=oven/bun:1.3.10 /usr/local/bin/bun /usr/local/bin/bun

RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx \
    && apt-get update \
    && apt-get install -y --no-install-recommends gosu \
    && rm -rf /var/lib/apt/lists/* \
    && if ! getent group "${DEV_GID}" >/dev/null; then groupadd --gid "${DEV_GID}" app; fi \
    && useradd --uid "${DEV_UID}" --gid "${DEV_GID}" --create-home --non-unique app

WORKDIR /app/ui

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 5173

ENTRYPOINT ["docker-entrypoint.sh"]

